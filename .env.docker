# Env vars for the `app`/`preview` docker-compose services. No secrets live here — everything
# points at other local containers — so this file is committed, unlike .env/.env.local.
BASE_PATH=/

# Local stand-in for the S3 bucket tagger-sync/spellchroma-index used to publish to (see
# docker/data-sync/ and the `tagdata` service in docker-compose.yml). Populate it once with:
#   docker compose run --rm tagger-sync
#   docker compose run --rm spellchroma-index
VITE_TAG_REPO_URL=http://localhost:8081/tagger-tags.json
VITE_SPELLCHROMA_DICT_URL=http://localhost:8081/spellchroma-tag-dictionary.json
VITE_SPELLCHROMA_INDEX_URL=http://localhost:8081/spellchroma-tag-index.json

# Left unset on purpose: the poll (feature-suggestion board) and metrics dashboard talk to what
# used to be a Lambda + DynamoDB API. There's no local equivalent yet, so those screens just show
# their "not configured" empty state. Point this at a local API of your own if you build one.
# VITE_ANALYTICS_URL=
